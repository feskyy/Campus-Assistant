rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'group', 'updatedAt'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100))
        && (!('group' in request.resource.data) || (request.resource.data.group is string && request.resource.data.group.size() > 0 && request.resource.data.group.size() <= 100))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp)
        && (!('group' in request.resource.data) || 'updatedAt' in request.resource.data);
      match /favorites/{favoriteId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasAll(['kind', 'itemId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['kind', 'itemId', 'createdAt'])
          && request.resource.data.kind in ['news', 'event']
          && request.resource.data.itemId is string
          && request.resource.data.itemId.size() > 0
          && request.resource.data.itemId.size() <= 200
          && request.resource.data.createdAt is timestamp;
      }
      match /devices/{deviceId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['token'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}